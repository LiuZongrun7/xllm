# xLLM · 环境变量模板
# -----------------------------------------------------------------------------
# 用法：
#   cp .env.example .env      # 然后填入真实值
#   .env 已被 .gitignore 排除，绝对不能提交
# 本地开发也可以直接 export，不建文件；但生产必须走 .env（systemd EnvironmentFile）
# -----------------------------------------------------------------------------

# Flask 会话签名。生产务必换成随机值，否则 session 可被伪造。
# 生成：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ---------------- 数据库 ----------------
# 密码里若有 @ : / # 等字符，config.py 会自动做 URL 编码，不用自己转义
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=webapp
DB_USER=webapp
DB_PASSWORD=

# ---------------- 邮件（验证码 / 找回密码）----------------
# MAIL_PASSWORD 是腾讯企业邮的【客户端授权码】，不是邮箱登录密码
# MAIL_SENDER 必须与 MAIL_USER 同账号（企业邮用认证账号校验 From）
MAIL_HOST=smtp.exmail.qq.com
MAIL_PORT=465
MAIL_USER=no-reply@xllm.cloud
MAIL_PASSWORD=
MAIL_SENDER_NAME="xLLM Food Delivery"
# 用户点"回复"落到的信箱；不需要该邮箱的任何凭据
MAIL_REPLY_TO=contact@xllm.cloud

# ---------------- 高德地图（可选）----------------
# 三个都为空时，地址页自动降级为"纯文本地址 + 城市中心坐标"，下单流程不受影响。
# AMAP_JS_KEY / AMAP_SECURITY_JS_CODE 由前端动态加载 JS API 时使用；
# AMAP_WEB_KEY 只在服务端做逆地理编码时才需要。
AMAP_JS_KEY=
AMAP_SECURITY_JS_CODE=
AMAP_WEB_KEY=

# ---------------- 域名（可选）----------------
# 三个端各有一个子域名。留空 = 不做分流，三端仍在同一域名下按 /customer
# /merchant /rider 访问（本地开发就保持留空）。
# 只写协议以外的部分，不要带 https:// 和结尾斜杠。
SITE_HOST=
CUSTOMER_HOST=
MERCHANT_HOST=
RIDER_HOST=

# ---------------- 会话 / Cookie ----------------
# 线上全站 HTTPS → 设 1；本地 http://127.0.0.1 调试 → 设 0，否则浏览器不传 cookie
SESSION_COOKIE_SECURE=0
